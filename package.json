{
  "name": "notion-todoist-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bi-directional Notion ↔ Todoist sync running on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test",
    "db:migrate": "wrangler d1 migrations apply notion-todoist-sync --remote"
  },
  "license": "ISC",
  "devDependencies": {
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
